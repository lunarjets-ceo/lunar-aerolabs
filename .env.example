# Postgres connection string (Neon, Supabase, RDS…). Required in production.
# Leave unset locally to use an embedded database stored in .data/
DATABASE_URL=

# 32+ random characters. Encrypts authenticator secrets at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# First-admin bootstrap at /sign/setup. Works only while no admin exists.
ADMIN_EMAIL=
SETUP_TOKEN=

# Public URL used in email links, e.g. https://lunaraerolabs.com
APP_URL=

# Optional: send invitation and signing emails through Resend.
# Without these, the admin screens show copyable links instead.
RESEND_API_KEY=
EMAIL_FROM="Lunar AeroLabs <hello@lunaraerolabs.com>"
